{
    "firestore":  {
                      "indexes":  "firestore.indexes.json",
                      "rules":  "firestore.rules"
                  },
    "hosting":  {
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "public":  "frontend-dist",
                    "rewrites":  [
                                     {
                                         "destination":  "/index.html",
                                         "source":  "**"
                                     }
                                 ]
                }
}
